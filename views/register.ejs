<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Page</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: "#1E293B" /* Dark Blue */,
              secondary: "#475569" /* Grayish Blue */,
              accent: "#06b6d4" /* Cyan */,
            },
          },
        },
      };
    </script>
  </head>
  <body
    class="bg-primary text-white flex items-center justify-center min-h-screen"
  >
    <div class="bg-secondary p-8 rounded-lg shadow-lg max-w-md w-full">
      <h1 class="text-2xl font-bold text-center mb-4">Register</h1>

      <!-- Flash Messages -->
      <%- include('partials/messages') %>

      <form action="/register" method="POST" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-accent text-black"
            placeholder="Enter Name"
            value="<%= typeof name != 'undefined' ? name : '' %>"
            required
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-accent text-black"
            placeholder="Enter Email"
            value="<%= typeof email != 'undefined' ? email : '' %>"
            required
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium"
            >Password</label
          >
          <input
            type="password"
            id="password"
            name="password"
            class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-accent text-black"
            placeholder="Create Password"
            value="<%= typeof password != 'undefined' ? password : '' %>"
            required
          />
        </div>

        <div>
          <label for="password2" class="block text-sm font-medium"
            >Confirm Password</label
          >
          <input
            type="password"
            id="password2"
            name="password2"
            class="w-full p-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-accent text-black"
            placeholder="Confirm Password"
            value="<%= typeof password2 != 'undefined' ? password2 : '' %>"
            required
          />
        </div>

        <button
          type="submit"
          class="w-full bg-accent text-white py-2 rounded hover:bg-cyan-500 transition"
        >
          Register
        </button>
      </form>

      <p class="text-center mt-4 text-sm">
        Have an account?
        <a href="/login" class="text-accent hover:underline">Login</a>
      </p>
    </div>
  </body>
</html>
