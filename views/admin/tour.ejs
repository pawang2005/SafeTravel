<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookings</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">

    <div class="max-w-3xl mx-auto mt-10 p-6 bg-white shadow-lg rounded-lg">
        <h1 class="text-2xl font-bold text-center text-blue-600">Passenger Details</h1>

        <% tours.forEach(tour => { %>
            <div class="mt-6 p-4 border border-gray-300 rounded-lg shadow-sm bg-gray-50">
                <h2 class="text-lg font-semibold text-gray-700">
                    <%= tour.user.name %>'s Booking (Tour: <%= tour.tour.name %>)
                </h2>
                <ul class="mt-3 space-y-2">
                    <% tour.passengers.forEach(passenger => { %>
                        <li class="p-2 bg-white rounded-md shadow">
                            <span class="font-medium text-blue-600"><%= passenger.name %></span>, 
                            <span class="text-gray-600">Age: <%= passenger.age %></span>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% }) %>

    </div>

</body>
</html>
